         h.cheat_name = mh_cheat_name;
         h.cheat_get = mh_cheat_get;
         h.cheat_set = mh_cheat_set;
+        g_lan_emu = &emu;
+        h.lan_get = mh_lan_get;
+        h.lan_set = mh_lan_set;
         start_mark("menu options");
         bmenu_init(&h);
         start_mark("menu init");
