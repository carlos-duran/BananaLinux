     }
+    if (id == LR_PLAYERS && !lan_players_off() && LS.mode == BM_LAN_AUTO && lan_max_pick != LS.max_players) {
+        mlog("[menu] LAN: auto, %d players at most when it hosts\n", lan_max_pick);
+        H.lan_set(H.ctx, BM_LAN_AUTO, lan_max_pick, ""); lan_poll(); play(SND_SELECT); dirty_bot = 1; return;
+    }
     play(SND_SELECT);
 }
 static void lan_adjust(int d) {   /* left/right on the LAN page */
     lan_rows();
     const int id = lrows[sel_lan];
-    if (id == LR_MODE && !lan_locked()) { lan_pick = (lan_pick + d + BM_LAN_MODES) % BM_LAN_MODES; play(SND_MOVE); dirty_bot = 1; }
+    if (id == LR_MODE && !lan_locked()) {
+        int k = 0;
+        while (k < BM_LAN_MODES - 1 && lan_cycle[k] != lan_pick) k++;
+        lan_pick = lan_cycle[(k + d + BM_LAN_MODES) % BM_LAN_MODES]; play(SND_MOVE); dirty_bot = 1;
+    }
     else if (id == LR_PLAYERS && !lan_players_off()) {
         int v = lan_max_pick + d; v = v < 2 ? 2 : v > BM_LAN_MAX ? BM_LAN_MAX : v;
         if (v != lan_max_pick) { lan_max_pick = v; play(SND_MOVE); dirty_bot = 1; }
diff --git a/bananads/src/menu.h b/bananads/src/menu.h
index ad62b77..b230e45 100644
--- a/bananads/src/menu.h
+++ b/bananads/src/menu.h
@@ -21,7 +21,10 @@ typedef struct {
 enum { BM_UNDO_SLOT = 9 };
 
 /* the LAN multiplayer page (Quick settings > LAN multiplayer: wifi.local, melonDS's LAN), as the frontend reports it */
-enum { BM_LAN_OFF, BM_LAN_HOST, BM_LAN_JOIN, BM_LAN_MODES };   /* (an Auto mode would come after Join) */
+enum { BM_LAN_OFF, BM_LAN_HOST, BM_LAN_JOIN, BM_LAN_AUTO, BM_LAN_MODES };   /* (the page shows Off, Auto, Host, Join) */
+/* Auto's steps: waiting for the game to turn its wifi on, looking for hosts, joining one, hosting, joined, the game
+ * online (Nintendo WFC: no local session), held after a Disconnect (until the game's wifi goes off and on) */
+enum { BM_AUTO_WAIT, BM_AUTO_SEARCH, BM_AUTO_JOINING, BM_AUTO_HOST, BM_AUTO_JOINED, BM_AUTO_ONLINE, BM_AUTO_HELD };
 enum { BM_LAN_IDLE, BM_LAN_BUSY, BM_LAN_READY, BM_LAN_FAILED };  /* idle: off or looking for hosts; ready: hosting or joined */
 #define BM_LAN_MAX 16
 typedef struct {
@@ -35,6 +38,8 @@ typedef struct {
     struct { char name[32]; int host, me, ping; } players[BM_LAN_MAX];   /* ping in ms, -1 unknown */
     int nhosts;           /* join, looking: the hosts on the network */
     struct { char name[64]; char addr[48]; int players, max; } hosts[BM_LAN_MAX];
+    int phase;            /* auto: BM_AUTO_* */
+    int untagged;         /* auto, joined: the host doesn't say its game (desktop melonDS) */
 } bmenu_lan;
 
 typedef struct {
@@ -84,6 +89,7 @@ typedef struct {
     int (*live)(void* ctx);
     // LAN multiplayer (Quick settings): lan_get fills st, 0 when this build has no LAN (no row). lan_set asks for a
     // mode: BM_LAN_HOST with max_players, BM_LAN_JOIN with a host's address to join it or "" to look for hosts,
+    // BM_LAN_AUTO with max_players (addr "hold": Disconnect, Auto waits for the game's wifi to go off and on),
     // BM_LAN_OFF; the mode (not the address) is kept for the next game. It returns at once: lan_get says when it is
     // done (a join can take 5 s). Mode changes only outside a local wireless game (mp_lock, live): the menu sees to it
     int (*lan_get)(void* ctx, bmenu_lan* st);
