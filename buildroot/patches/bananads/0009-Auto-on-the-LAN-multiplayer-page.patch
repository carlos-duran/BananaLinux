From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Carlos Duran <15650777+carlos-duran@users.noreply.github.com>
Subject: [PATCH] BananaDS: Auto on the LAN multiplayer page

The Mode row goes Off, Auto, Host, Join. Auto shows what it does: waiting for the game, looking for a host of this
game, hosting (with the players), in a host's session (a desktop melonDS host said as such), the game online through
Nintendo WFC, or disconnected until the game turns its wireless off and on. Players, labelled "Players (if hosting)"
in Auto, sets the session's size when Auto hosts, and applies again while it hosts alone. Disconnect ends or leaves
the session and holds Auto. The mode and the size are kept in bananads.conf (wifi.local = auto, wifi.local_players)
like the others; bananads.env still wins at each start and the page says so.
---
 bananads/src/frontend_kms.cpp | 16 +++++--
 bananads/src/menu.c           | 84 +++++++++++++++++++++++++++++------
 bananads/src/menu.h           |  8 +++-
 3 files changed, 89 insertions(+), 19 deletions(-)

diff --git a/bananads/src/frontend_kms.cpp b/bananads/src/frontend_kms.cpp
index 42c3dc2..655c116 100644
--- a/bananads/src/frontend_kms.cpp
+++ b/bananads/src/frontend_kms.cpp
@@ -1161,7 +1161,12 @@ static int mh_lan_get(void*, bmenu_lan* st) {
     if (!g_lan_emu) return 0;
     const Emu::LanStatus l = g_lan_emu->lan_status();
     if (!l.built) return 0;
-    st->mode = l.mode == Emu::LanMode::Host ? BM_LAN_HOST : l.mode == Emu::LanMode::Join ? BM_LAN_JOIN : BM_LAN_OFF;
+    st->mode = l.mode == Emu::LanMode::Host ? BM_LAN_HOST : l.mode == Emu::LanMode::Join ? BM_LAN_JOIN
+             : l.mode == Emu::LanMode::Auto ? BM_LAN_AUTO : BM_LAN_OFF;
+    static const int phases[] = {BM_AUTO_WAIT, BM_AUTO_SEARCH, BM_AUTO_JOINING, BM_AUTO_HOST, BM_AUTO_JOINED,
+                                 BM_AUTO_ONLINE, BM_AUTO_HELD};   // (Emu::AutoPhase's order)
+    st->phase = phases[(int)l.phase];
+    st->untagged = l.host_untagged;
     st->state = l.state == Emu::LanState::Busy ? BM_LAN_BUSY : l.state == Emu::LanState::Ready ? BM_LAN_READY
               : l.state == Emu::LanState::Failed ? BM_LAN_FAILED : BM_LAN_IDLE;
     st->max_players = l.max_players;
@@ -1192,10 +1197,13 @@ static int mh_lan_get(void*, bmenu_lan* st) {
 }
 static void mh_lan_set(void*, int mode, int max_players, const char* addr) {
     if (!g_lan_emu) return;
-    const Emu::LanMode m = mode == BM_LAN_HOST ? Emu::LanMode::Host : mode == BM_LAN_JOIN ? Emu::LanMode::Join : Emu::LanMode::Off;
+    const Emu::LanMode m = mode == BM_LAN_HOST ? Emu::LanMode::Host : mode == BM_LAN_JOIN ? Emu::LanMode::Join
+                         : mode == BM_LAN_AUTO ? Emu::LanMode::Auto : Emu::LanMode::Off;
     g_lan_emu->lan_request(m, addr ? addr : "", max_players);
-    save_opt("wifi.local", m == Emu::LanMode::Host ? "host" : m == Emu::LanMode::Join ? "join" : "off");
-    if (m == Emu::LanMode::Host && max_players >= 2) save_opt("wifi.local_players", std::to_string(max_players));
+    save_opt("wifi.local", m == Emu::LanMode::Host ? "host" : m == Emu::LanMode::Join ? "join"
+                         : m == Emu::LanMode::Auto ? "auto" : "off");
+    if ((m == Emu::LanMode::Host || m == Emu::LanMode::Auto) && max_players >= 2)
+        save_opt("wifi.local_players", std::to_string(max_players));
 }
 
 // ---- the frontend ---------------------------------------------------------------------------------------------
