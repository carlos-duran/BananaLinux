     LastHostID = -1;
@@ -265,6 +273,9 @@ bool LAN::StartDiscovery()
     DiscoveryLastTick = (u32)Platform::GetMSCount();
     DiscoveryList.clear();
 
+    MPActiveBitmask = 0;
+    memset(MPMissCount, 0, sizeof(MPMissCount));
+    MyMACKnown = false;
     Active = true;
     return true;
 }
@@ -316,6 +327,9 @@ bool LAN::StartHost(const char* playername, int numplayers)
     LastHostID = -1;
     LastHostPeer = nullptr;
 
+    MPActiveBitmask = 0;
+    memset(MPMissCount, 0, sizeof(MPMissCount));
+    MyMACKnown = false;
     Active = true;
     IsHost = true;
 
@@ -428,6 +442,9 @@ bool LAN::StartClient(const char* playername, const char* host)
     RemotePeers[0] = peer;
     peer->data = &Players[0];
 
+    MPActiveBitmask = 0;
+    memset(MPMissCount, 0, sizeof(MPMissCount));
