#!/bin/sh
# Direct link: handhelds on a radio cell of their own (IBSS, "ad hoc"), without a router, for BananaDS's local
# wireless over the network (one radio hop instead of two: the 2026-10-28 proof of concept went from p50 6.7 ms to
# 2.9 ms of ping between two consoles). BananaDS's LAN multiplayer page runs it (Connection: Direct); it also works
# by hand over SSH, but SSH is lost while the link is up (the console leaves the home network).
#   wifi-link up host|join [--owner PID] [--channel N | --freq MHZ] [--max SECONDS]
#   wifi-link down [--sleep] [--nowait]
#   wifi-link status
# up: BananaOS's Wi-Fi goes down (wifi down), its lock (/run/banana/wifi.lock) is held while the link is up, so
# Settings' up/down/scan wait instead of fighting it, and an own wpa_supplicant joins (or starts) the open IBSS
# "bananalink" on 2.4 GHz channel 1 with a fixed BSSID (all of them in one cell from the start). No DHCP: static
# addresses in 10.42.0.0/16, a host 10.42.0.1 (another one if that's taken), a player 10.42.A.B from wlan0's MAC
# (A, B 1-254: never in 10.42.0.x), each checked first with an ARP probe (arping -D) and moved on a clash. A device
# default route (no gateway) lets 255.255.255.255 broadcasts out (BananaDS's discovery, from an INADDR_ANY socket).
# up again with the other role only changes the address. It prints "ok state=up role=... ip=... freq=..." or
# "error <why>" (exit 1), within ~50 s (a player looks for the host's cell up to 15 s first).
# A supervisor (its own session, so it outlives the caller) holds the link and puts the home Wi-Fi back
# (wifi up, only if it was up before) when: down is asked; the owner (--owner, BananaDS's pid) is gone (a crash);
# the owner is stopped for 1 s (bananad's SIGSTOP before a sleep: then the link only comes down and sleep.d's
# 10-wifi brings the Wi-Fi back after the wake); its wpa_supplicant dies; --max seconds have passed (by hand: a
# safety net); or it is killed (its trap). A watchdog of its own does the same if the supervisor dies without it.
# A reboot undoes everything too (nothing is kept but the log).
# Security: this wpa_supplicant 2.11 is built without CONFIG_IBSS_RSN ("IBSS RSN not supported in the build"), so
# the cell is open (unencrypted, anyone in reach can join it). Settings in /data/banana/wifi-link.conf (KEY=value
# lines, read, never run): CHANNEL (1-11), FREQ (MHz, wins over CHANNEL), SSID, BSSID; BANANA_LINK_<KEY> in the
# environment wins over the file; the options win over both.
WIFI=${BANANA_LINK_WIFI:-/usr/libexec/banana/wifi}
D=${BANANA_LINK_DIR:-${BANANA_LINK_RUN:-/run/banana}/wifi-link}
LOG=${BANANA_LINK_LOG:-/data/banana/logs/wifi-link.log}
CONF=${BANANA_LINK_CONF:-/data/banana/wifi-link.conf}
IF=wlan0
RUN=${BANANA_LINK_RUN:-/run/banana}      # (these two only for the tests: BananaOS's own places)
SYS=${BANANA_LINK_SYS:-/sys/class/net}
WIFILOCK=$RUN/wifi.lock
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
CTRL=$D/ctrl
W="wpa_cli -p $CTRL -i $IF"

log() { echo "$(date '+%F %T') [$$] $*" >> "$LOG" 2>/dev/null; }
say() { echo "$*"; log "$*"; }
st_get() { sed -n "s/^$1=//p" "$D/state" 2>/dev/null; }
st_set() {   # st_set key=value...: the state file rewritten whole (read by status and the up/down waiting)
    { for kv in "$@"; do echo "$kv"; done
      for k in state role ip freq ssid owner since msg; do
          case " $* " in *" $k="*) ;; *) v=$(st_get $k); [ -n "$v" ] && echo "$k=$v" ;; esac
      done; } > "$D/state.tmp"
    mv -f "$D/state.tmp" "$D/state"
}
# lock_wait FD SECONDS: flock with a timeout (BusyBox's flock has no -w: -n, tried every 0.2 s)
lock_wait() {
    _n=0
    while ! flock -n "$1" 2>/dev/null; do
        [ $_n -ge $(($2 * 5)) ] && return 1
        sleep 0.2; _n=$((_n + 1))
    done
}
alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
super_pid() { p=$(cat "$D/super.pid" 2>/dev/null); alive "$p" && echo "$p"; }

# the settings: the file, then the environment, then the options
conf() {
    SSID=bananalink BSSID=02:42:4e:41:00:01 CHANNEL=1 FREQ=
    if [ -f "$CONF" ]; then
        while IFS='=' read -r k v || [ -n "$k" ]; do
            k=$(echo "$k" | tr -d ' \t\r'); v=$(echo "$v" | tr -d ' \t\r"'"'")
            case $k in SSID) SSID=$v ;; BSSID) BSSID=$v ;; CHANNEL) CHANNEL=$v ;; FREQ) FREQ=$v ;; esac
        done < "$CONF"
    fi
    [ -n "$BANANA_LINK_SSID" ] && SSID=$BANANA_LINK_SSID
    [ -n "$BANANA_LINK_BSSID" ] && BSSID=$BANANA_LINK_BSSID
    [ -n "$BANANA_LINK_CHANNEL" ] && CHANNEL=$BANANA_LINK_CHANNEL
    [ -n "$BANANA_LINK_FREQ" ] && FREQ=$BANANA_LINK_FREQ
    # (into wpa_supplicant's file: letters, digits, . _ - only; a BSSID as six hex pairs, else the defaults)
    SSID=$(printf '%s' "$SSID" | tr -cd 'A-Za-z0-9._-' | cut -c1-32); [ -n "$SSID" ] || SSID=bananalink
    case $BSSID in [0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]) ;;
    *) BSSID=02:42:4e:41:00:01 ;; esac
    return 0
}
# 2.4 GHz channel -> MHz; the world regulatory domain (no regulatory.db on BananaOS) lets an IBSS start on 1-11
chan_freq() {
    case $1 in
    [1-9]|1[01]) echo $((2407 + 5 * $1)) ;;
    *) return 1 ;;
    esac
}
check_freq() {   # FREQ from CHANNEL if not set; else why not in WHY
    WHY=
    if [ -z "$FREQ" ]; then FREQ=$(chan_freq "$CHANNEL") || { WHY="channel $CHANNEL: use 1-11"; return 1; }; fi
    case $FREQ in *[!0-9]*|'') WHY="frequency $FREQ: not a number of MHz"; return 1 ;; esac
    case $FREQ in 24[0-9][0-9]) ;; *) log "frequency $FREQ MHz: outside 2.4 GHz (5 GHz is no-IR here: it may not start)" ;; esac
    return 0
}

# ---- addresses -------------------------------------------------------------------------------------------
mac_bytes() { tr -d ':' < $SYS/$IF/address 2>/dev/null | sed 's/.*\(..\)\(..\)$/\1 \2/'; }
# candidate k (0-7) for a player: 10.42.A.B from the MAC's last two bytes, A and B in 1-254
cand_join() {
    # shellcheck disable=SC2046  # (the two bytes as two words)
    set -- $(mac_bytes) "$1"
    [ -n "$2" ] || { set -- 00 00 "$1"; }
    a=$(( (0x$1 + $3 * 53) % 254 + 1 )); b=$(( (0x$2 + $3 * 37) % 254 + 1 ))
    echo "10.42.$a.$b"
}
# free: nobody answers an ARP probe for it (DAD, from 0.0.0.0). No arping: taken as free
free_ip() {
    command -v arping >/dev/null 2>&1 || return 0
    arping -D -q -I $IF -c 2 -w 2 "$1" >/dev/null 2>&1
}
pick_ip() {   # pick_ip host|join: the first free candidate
    if [ "$1" = host ]; then
        free_ip 10.42.0.1 && { echo 10.42.0.1; return 0; }
        log "10.42.0.1 is taken (another host on the link): an address from the MAC instead"
    fi
    k=0
    while [ $k -lt 8 ]; do
        ip=$(cand_join $k)
        free_ip "$ip" && { echo "$ip"; return 0; }
        log "$ip is taken: the next one"
        k=$((k + 1))
    done
    return 1
}
set_ip() {
    ip addr flush dev $IF 2>/dev/null
    ip addr add "$1/16" brd 10.42.255.255 dev $IF || return 1
    # (no default route: sendto 255.255.255.255 from an INADDR_ANY socket is ENETUNREACH)
    ip route replace default dev $IF 2>>"$LOG" || ip route add default dev $IF 2>>"$LOG"
    return 0
}
# The cell: mac80211's own IBSS join does 2 short scans and, if they miss the cell (two consoles busy with a game:
# the 2026-10-29 test), starts one of its own with the same fixed BSSID, which it never merges again and which may
# not hear the other (the player "looking for hosts" for good). So the network starts disabled and the cell is
# looked for here first, for longer: our own scans until a beacon of the BSSID is fresh (age <= 2 s: someone else
# sends it; our own entry left from before only ages), then joined (mac80211 then adopts it, "Selected IBSS BSSID").
# A player looks for up to 15 s (else it starts the cell: the host may come later), a host 3 s (a player already
# there). And a player checks every 10 s that the host answers (ARP, 10.42.0.1); while it doesn't, it leaves the
# cell, looks for a fresh beacon (35 s at most) and joins again.
cell_seen() {   # cell_seen SECONDS: a fresh beacon of the BSSID within that time
    _t=$(( $(date +%s) + $1 ))
    while [ "$(date +%s)" -lt $_t ]; do
        [ -f "$D/stop" ] && return 1
        [ -n "$OWNER" ] && ! alive "$OWNER" && return 1   # (the owner gone: the loop restores at once)
        $W scan freq="$FREQ" >/dev/null 2>&1
        sleep 1.5
        a=$($W bss "$BSSID" 2>/dev/null | sed -n 's/^age=//p')
        [ -n "$a" ] && [ "$a" -le 2 ] && return 0
    done
    return 1
}
join_cell() {   # join_cell SECONDS: the cell looked for, then joined (or started); 0 if found
    _f=1; cell_seen "$1" && _f=0
    $W enable_network 0 >/dev/null 2>&1; $W reconnect >/dev/null 2>&1
    i=0; while [ $i -lt 40 ]; do $W status 2>/dev/null | grep -qx wpa_state=COMPLETED && break; [ -f "$D/stop" ] && break; sleep 0.5; i=$((i + 1)); done
    ip route replace default dev $IF 2>/dev/null
    return $_f
}
host_heard() { arping -q -I $IF -c 2 -w 3 10.42.0.1 >/dev/null 2>&1; }
# A cell alone for 30 s: mac80211 scans for another one to merge with ("No active IBSS STAs ... (merge)"), and on
# these handhelds (rtw88_8821cs) the cell then stops being heard: a player that comes later sees no beacon, starts a
# cell of its own and never gets the host's broadcasts (BananaDS's discovery: "looking for hosts" for good; unicast,
# ARP and ping, still pass). The 2026-10-29 tests: a player within 30 s of the host always found it, one after
# its first merge scan almost never. So a host that receives nothing (wlan0's rx_packets still) starts its cell
# again every 20 s, before that scan; a player's cell, if one started its own, is adopted then.
rx_count() { cat $SYS/$IF/statistics/rx_packets 2>/dev/null || echo 0; }
renew_cell() { $W disconnect >/dev/null 2>&1; join_cell 0; }
rejoin() { $W disconnect >/dev/null 2>&1; join_cell 35; }

# ---- the supervisor --------------------------------------------------------------------------------------
LOCKED='' MODE=normal HOME_UP=''
restore() {
    trap '' EXIT INT TERM HUP
    [ -f "$D/restored" ] && return
    st_set state=stopping
    log "restore ($MODE): the link's wpa_supplicant stopped"
    p=$(cat "$D/wpa.pid" 2>/dev/null)
    if alive "$p"; then
        kill "$p" 2>/dev/null
        i=0; while [ $i -lt 10 ] && alive "$p"; do sleep 0.3; i=$((i + 1)); done
        alive "$p" && kill -9 "$p" 2>/dev/null
    fi
    rm -f "$D/wpa.pid" "$CTRL/$IF"
    ip route flush dev $IF 2>/dev/null; ip addr flush dev $IF 2>/dev/null; ip link set $IF down 2>/dev/null
    [ -n "$LOCKED" ] && { flock -u 8; exec 8>&-; LOCKED=; }
    if [ -z "$HOME_UP" ]; then
        log "restore: BananaOS's Wi-Fi was off before the link: left off"
    elif [ "$MODE" = sleep ]; then
        touch "$RUN/wifi-was-up"   # (sleep.d/10-wifi's: Wi-Fi up again after the wake)
        log "restore: sleeping: the Wi-Fi comes back after the wake (sleep.d/10-wifi)"
    else
        # (during a suspend wlan0 is gone for a while: wifi up waits for it, up to 60 s)
        i=0; while [ ! -d "$SYS/$IF" ] && [ $i -lt 120 ]; do sleep 0.5; i=$((i + 1)); done
        log "restore: $WIFI up"
        "$WIFI" up >> "$LOG" 2>&1 9>&- || log "restore: wifi up failed"
    fi
    touch "$D/restored"
    st_set state=down role= ip=   # (msg kept: a failure's reason, for up)
    rm -f "$D/super.pid" "$D/stop"
    # the home network back: logged; no address after 25 s, BananaOS's wifi restart once
    if [ -n "$HOME_UP" ] && [ "$MODE" != sleep ]; then
        i=0
        while [ $i -lt 40 ]; do
            [ -f "$D/super.pid" ] && return   # (a new link meanwhile)
            a=$(ip -4 -o addr show $IF 2>/dev/null | awk '{print $4}')
            [ -n "$a" ] && { log "restore: home Wi-Fi back at $a after $i s"; return; }
            [ $i = 25 ] && { log "restore: no address after 25 s: $WIFI restart"; "$WIFI" restart >> "$LOG" 2>&1 9>&-; }
            sleep 1; i=$((i + 1))
        done
        log "restore: no home address after 40 s (Settings > Network, or a reboot)"
    fi
}
fail() { st_set state=failed msg="$*"; log "failed: $*"; exit 1; }   # (the EXIT trap restores)

supervise() {   # _supervise ROLE OWNER FREQ MAX HOME_UP
    conf
    ROLE=$1 OWNER=$2 FREQ=${3:-2412} MAX=$4 HOME_UP=$5
    echo $$ > "$D/super.pid"
    rm -f "$D/restored" "$D/stop"
    trap 'restore' EXIT
    # down: the mode in the stop file, then TERM (also while it is still starting)
    trap 'MODE=$(cat "$D/stop" 2>/dev/null); [ "$MODE" = sleep ] || MODE=normal; log "signal ($MODE): restoring"; exit 0' INT TERM HUP
    st_set state=starting role="$ROLE" ip= freq="$FREQ" ssid="$SSID" owner="$OWNER" since="$(date +%s)" msg=
    # the watchdog: the supervisor gone without its restore (kill -9): the same, from outside
    setsid sh "$SELF" _watchdog $$ "$HOME_UP" < /dev/null > /dev/null 2>&1 &
    "$WIFI" down >> "$LOG" 2>&1 9>&-
    exec 8>"$WIFILOCK"
    lock_wait 8 10 && LOCKED=1 || fail "BananaOS's Wi-Fi is busy (wifi.lock)"
    pidof wpa_supplicant >/dev/null && { log "a wpa_supplicant still runs: stopped"; killall wpa_supplicant 2>/dev/null; sleep 0.5; }
    mkdir -p "$CTRL"
    cat > "$D/wpa.conf" <<C
ctrl_interface=$CTRL
ap_scan=2
update_config=0
network={
    ssid="$SSID"
    mode=1
    frequency=$FREQ
    bssid=$BSSID
    key_mgmt=NONE
    disabled=1
}
C
    ip addr flush dev $IF 2>/dev/null
    ip link set $IF up || fail "wlan0 doesn't come up"
    wpa_supplicant -B -i $IF -c "$D/wpa.conf" -P "$D/wpa.pid" -f "$D/wpa.log" 8>&- 9>&- || fail "wpa_supplicant (IBSS) didn't start"
    i=0; while [ $i -lt 20 ] && ! $W ping >/dev/null 2>&1; do sleep 0.25; i=$((i + 1)); done
    if [ "$ROLE" = join ]; then w=15; else w=3; fi
    if join_cell $w; then log "the cell is there: joined"; else log "no cell heard in $w s: this one starts it"; fi
    [ -f "$D/stop" ] && { log "down asked while starting"; exit 0; }
    $W status 2>/dev/null | grep -qx wpa_state=COMPLETED || fail "no IBSS cell after 20 s (wpa_supplicant: $D/wpa.log)"
    log "ibss: $($W status 2>/dev/null | grep -e '^bssid' -e '^freq' -e '^ssid' -e '^mode' | tr '\n' ' ')"
    IP=$(pick_ip "$ROLE") || fail "no free address on the link"
    set_ip "$IP" || fail "the address $IP couldn't be set"
    st_set state=up ip="$IP"
    log "up: $ROLE at $IP, $SSID on $FREQ MHz, owner ${OWNER:-none}, max ${MAX}s"
    t0=$(date +%s) stopped=0 next=0 tries=0 heard='' rx=$(rx_count) rx_t=$(date +%s) renews=0
    while :; do
        [ -f "$D/stop" ] && { MODE=$(cat "$D/stop" 2>/dev/null); [ "$MODE" = sleep ] || MODE=normal; log "down asked ($MODE)"; break; }
        if [ -n "$OWNER" ]; then
            alive "$OWNER" || { log "the owner ($OWNER) is gone: restoring"; break; }
            s=$(sed 's/^.*) \(.\).*/\1/' /proc/$OWNER/stat 2>/dev/null)
            if [ "$s" = T ]; then stopped=$((stopped + 1)); else stopped=0; fi
            [ $stopped -ge 2 ] && { MODE="sleep"; log "the owner is stopped (going to sleep): the link comes down"; break; }
        fi
        alive "$(cat "$D/wpa.pid" 2>/dev/null)" || { log "the link's wpa_supplicant died: restoring"; break; }
        [ "${MAX:-0}" -gt 0 ] && [ $(( $(date +%s) - t0 )) -ge "$MAX" ] && { log "$MAX s are up: restoring"; break; }
        now=$(date +%s)
        if [ "$(st_get ip)" = 10.42.0.1 ]; then   # the host: its cell started again while nobody is heard
            r=$(rx_count)
            if [ "$r" != "$rx" ]; then
                [ $renews -gt 0 ] && log "host: a player is heard (after $renews new starts of the cell)"
                rx=$r rx_t=$now renews=0
            elif [ $((now - rx_t)) -ge 20 ]; then
                renews=$((renews + 1))
                [ $renews -eq 1 ] && log "host: nobody heard for 20 s: the cell starts again every 20 s until a player is"
                if renew_cell; then log "host: another cell heard: joined it"; fi
                rx=$(rx_count) rx_t=$(date +%s)
            fi
        fi
        if [ "$now" -ge "$next" ] && [ "$(st_get role)" = join ] && [ "$(st_get ip)" != 10.42.0.1 ]; then
            if host_heard; then
                [ -n "$heard" ] || log "join: the host answers$([ $tries -gt 0 ] && echo " (after $tries new joins)")"
                heard=1 tries=0 next=$((now + 10))
            else
                [ -n "$heard" ] && log "join: the host stopped answering"
                heard='' tries=$((tries + 1))
                log "join: no answer from the host (10.42.0.1): looking for its cell again ($tries)"
                if rejoin; then log "join: a cell heard: joined it"; else log "join: no other cell heard in 35 s"; fi
                next=$(($(date +%s) + 2))
            fi
        fi
        sleep 0.5
    done
    exit 0
}

watchdog() {   # _watchdog SUPER_PID HOME_UP
    while alive "$1"; do sleep 2; done
    [ -f "$D/restored" ] && exit 0
    p=$(cat "$D/super.pid" 2>/dev/null); [ -n "$p" ] && [ "$p" != "$1" ] && exit 0   # (a new link since)
    log "watchdog: the supervisor $1 is gone without restoring: restoring"
    p=$(cat "$D/wpa.pid" 2>/dev/null); alive "$p" && kill "$p" 2>/dev/null
    rm -f "$D/wpa.pid" "$D/super.pid"
    ip route flush dev $IF 2>/dev/null; ip addr flush dev $IF 2>/dev/null
    touch "$D/restored"; st_set state=down role= ip= msg="restored by the watchdog"
    [ -n "$2" ] && "$WIFI" restart >> "$LOG" 2>&1
    exit 0
}

# ---- the commands ----------------------------------------------------------------------------------------
cmd_up() {
    ROLE=$1; shift
    case $ROLE in host|join) ;; *) echo "usage: wifi-link up host|join [--owner PID] [--channel N|--freq MHZ] [--max S]" >&2; exit 2 ;; esac
    conf; OWNER=$BANANA_LINK_OWNER MAX=0
    while [ $# -gt 0 ]; do
        case $1 in
        --owner) OWNER=$2; shift ;;
        --channel) CHANNEL=$2; FREQ=; shift ;;
        --freq) FREQ=$2; shift ;;
        --max) MAX=$2; shift ;;
        *) echo "wifi-link: unknown option $1" >&2; exit 2 ;;
        esac
        shift
    done
    case $MAX in ''|*[!0-9]*) MAX=0 ;; esac
    case $OWNER in *[!0-9]*) OWNER= ;; esac
    check_freq || { say "error $WHY"; exit 1; }
    [ -d $SYS/$IF ] || { say "error no $IF (Wi-Fi driver not loaded)"; exit 1; }
    # one up/down at a time
    exec 7>"$D/cmd.lock"; lock_wait 7 30 || { say "error another wifi-link command is running"; exit 1; }
    if p=$(super_pid) && [ "$(st_get state)" = up ]; then
        if [ "$(st_get role)" = "$ROLE" ]; then
            say "ok state=up role=$ROLE ip=$(st_get ip) freq=$(st_get freq) (already up)"; exit 0
        fi
        IP=$(pick_ip "$ROLE") || { say "error no free address on the link"; exit 1; }
        set_ip "$IP" || { say "error the address $IP couldn't be set"; exit 1; }
        st_set role="$ROLE" ip="$IP"
        say "ok state=up role=$ROLE ip=$IP freq=$(st_get freq) (role changed)"; exit 0
    fi
    if p=$(super_pid); then   # starting or stopping: wait for it to settle, then start afresh
        echo normal > "$D/stop"; kill -TERM "$p" 2>/dev/null
        i=0; while [ $i -lt 30 ] && alive "$p"; do sleep 0.5; i=$((i + 1)); done
    fi
    # BananaOS's Wi-Fi was on (its wpa_supplicant's pid file): put back afterwards; else left off
    home=; [ -f "$RUN/wpa.pid" ] && home=1
    [ -f "$D/home-up" ] && [ ! -f "$D/restored" ] && home=$(cat "$D/home-up")   # (a link left behind)
    echo "$home" > "$D/home-up"
    log "=== up $ROLE (owner ${OWNER:-none}, $FREQ MHz, home Wi-Fi $([ -n "$home" ] && echo on || echo off))"
    rm -f "$D/state" "$D/restored"
    setsid sh "$SELF" _supervise "$ROLE" "$OWNER" "$FREQ" "$MAX" "$home" < /dev/null >> "$LOG" 2>&1 7>&- &
    i=0
    while [ $i -lt 100 ]; do
        s=$(st_get state)
        case $s in
        up) say "ok state=up role=$ROLE ip=$(st_get ip) freq=$(st_get freq)"; exit 0 ;;
        failed|down)
            if [ -n "$(st_get msg)" ] || [ -f "$D/restored" ]; then
                m=$(st_get msg); say "error ${m:-stopped before it came up}"; exit 1
            fi ;;
        esac
        sleep 0.5; i=$((i + 1))
    done
    say "error the link didn't come up in 50 s"
    echo normal > "$D/stop"; p=$(super_pid) && kill -TERM "$p" 2>/dev/null
    exit 1
}

cmd_down() {
    mode=normal wait=1
    for a in "$@"; do case $a in --sleep) mode="sleep" ;; --nowait) wait='' ;; esac; done
    # (an up still waiting for its link holds the command lock: down doesn't wait for it, the supervisor is told)
    exec 7>"$D/cmd.lock"; lock_wait 7 2 || log "down: an up is still waiting; going ahead"
    p=$(super_pid) || { echo "ok state=down"; exit 0; }
    log "=== down ($mode)"
    echo $mode > "$D/stop"; kill -TERM "$p" 2>/dev/null
    [ -n "$wait" ] || { echo "ok state=stopping"; exit 0; }
    i=0; while [ $i -lt 50 ] && [ ! -f "$D/restored" ]; do sleep 0.3; i=$((i + 1)); done
    [ -f "$D/restored" ] && { echo "ok state=down"; exit 0; }
    say "error the link is still coming down"; exit 1
}

cmd_status() {
    p=$(super_pid)
    s=$(st_get state); [ -n "$p" ] || s=down
    echo "state=${s:-down}"
    [ -n "$p" ] || exit 0
    for k in role ip freq ssid owner since msg; do v=$(st_get $k); [ -n "$v" ] && echo "$k=$v"; done
    # the other consoles seen on the link (ARP entries on wlan0 that answered)
    echo "peers=$(awk -v i=$IF '$6 == i && $3 == "0x2" { n++ } END { print n + 0 }' /proc/net/arp 2>/dev/null)"
    exit 0
}

mkdir -p "$D" "$(dirname "$LOG")" 2>/dev/null
case $1 in
up) shift; cmd_up "$@" ;;
down) shift; cmd_down "$@" ;;
status) cmd_status ;;
